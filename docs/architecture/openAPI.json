            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "roleName": {
            "type": "string"
          }
        }
      },
      "CityOptionDto": {
        "type": "object",
        "properties": {
          "cityId": {
            "type": "integer",
            "format": "int32"
          },
          "cityName": {
            "type": "string"
          }
        }
      },
      "LocationResponseDto": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "integer",
            "format": "int32"
          },
          "cityName": {
            "type": "string"
          },
          "locationName": {
            "type": "string"
          },
          "lng": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "transactionTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionTypeDto"
            }
          }
        }
      },
      "TransactionTypeDto": {
        "type": "object",
        "properties": {
          "transactionTypeName": {
            "type": "string"
          },
          "transactionTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "isAvailable": {
            "type": "boolean"
          }
        }
      },
      "LocationDetailDto": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "integer",
            "format": "int32"
          },
          "cityId": {
            "type": "integer",
            "format": "int32"
          },
          "locationName": {
            "type": "string"
          },
          "numberOfAtms": {
            "type": "integer",
            "format": "int32"
          },
          "imageData": {
            "type": "string"
          },
          "lng": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "transactionTypes": {
            "type": "array",
